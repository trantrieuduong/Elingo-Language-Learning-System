@startuml

skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam responseMessageBelowArrow true
skinparam sequenceGroupBorderThickness 1.5

skinparam participant {
    BackgroundColor #EEF4FF
    BorderColor     #4A7CFF
    FontStyle       Bold
}
skinparam actor {
    BackgroundColor #FEFEFE
    BorderColor     #333333
}
skinparam sequence {
    LifeLineBorderColor  #888888
    GroupBorderColor     #888888
    GroupBodyBackgroundColor #FAFAFA
    DividerBackgroundColor   #E8E8E8
}

actor "Người dùng" as User
participant "Client" as client
participant "UserController" as controller
participant "UserService" as service
participant "UserRepo" as repo
database "Database (MySQL)" as DB

User -> client : updatePassword(oldPassword,\nnewPassword, confirmPassword)
activate client

client -> controller : updatePassword(oldPassword,\nnewPassword, confirmPassword)
activate controller

controller -> service : validateUpdatePassword(oldPassword,\nnewPassword, confirmPassword)
activate service

alt password không hợp lệ
    service --> controller : passwordValidationError
    controller --> client : apiResponse
    client --> User : Thông báo lỗi:\n"Mật khẩu không hợp lệ"

else password hợp lệ
    service -> service : hashedPassword = hashPassword(newPassword)
    activate service
    deactivate service

    service -> repo : updatePassword(user.id, hashedPassword)
    activate repo

    repo -> DB : updatePassword(user.id, hashedPassword)
    activate DB

    DB --> repo : result
    deactivate DB

    repo --> service : result
    deactivate repo

    service --> controller : result
    deactivate service

    controller --> client : apiResponse
    deactivate controller

    client --> User : Thông báo:\n"Cập nhật mật khẩu thành công",\nLàm mới giao diện
    deactivate client
end
@enduml