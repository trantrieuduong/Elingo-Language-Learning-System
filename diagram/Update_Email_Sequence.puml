@startuml

skinparam sequenceArrowThickness 1.5
skinparam roundcorner 8
skinparam responseMessageBelowArrow true
skinparam sequenceGroupBorderThickness 1.5

skinparam participant {
    BackgroundColor #EEF4FF
    BorderColor     #4A7CFF
    FontStyle       Bold
}
skinparam actor {
    BackgroundColor #FEFEFE
    BorderColor     #333333
}
skinparam sequence {
    LifeLineBorderColor  #888888
    GroupBorderColor     #888888
    GroupBodyBackgroundColor #FAFAFA
    DividerBackgroundColor   #E8E8E8
}

actor "Người dùng" as User
participant "Client" as client
participant "UserController" as controller
participant "UserService" as service
participant "MailService" as mailService
participant "UserRepo" as repo
database "Redis" as redis
database "Database (MySQL)" as DB

User -> client : updateEmail(email)
activate client

client -> controller : updateEmail(email)
activate controller

controller -> service : validateUpdateEmail(email)
activate service

alt email không hợp lệ
    service --> controller : emailValidationError
    controller --> client : apiResponse
    client --> User : Thông báo lỗi:\n"Email không hợp lệ"

else email hợp lệ
    service -> service : otp = generateOTP()
    activate service
    deactivate service
    note right: Sinh và gửi 2 OTP\n(1 OTP đến email cũ,\n1 OTP đến email mới)

    service -> redis : saveOTP(user.id, otp)
    activate redis
    redis --> service : result
    deactivate redis

    service ->> mailService : sendOTPMail(email, otp)
    activate mailService
    mailService -->> User : Gửi email chứa mã OTP
    deactivate mailService

    service --> controller : result
    deactivate service
    controller --> client : apiResponse
    deactivate controller

    client --> User : Mở form nhập mã OTP
    deactivate client

    User -> client : confirmUpdateEmail(otp)
    activate client

    client -> controller : confirmUpdateEmail(otp)
    activate controller

    controller -> service : verifyOTP(user.id, otp)
    activate service

    service -> redis : getOTP(user.id)
    activate redis
    redis --> service : savedOTP
    deactivate redis

    alt OTP sai hoặc hết hạn
        service --> controller : otpValidationError
        controller --> client : apiResponse
        client --> User : Thông báo lỗi:\n"OTP sai hoặc hết hạn"

    else OTP hợp lệ

        service -> redis : deleteOTP(user.id)
        activate redis
        redis --> service : result
        deactivate redis

        service -> repo : updateEmail(user.id, email)
        activate repo

        repo -> DB : updateEmail(user.id, email)
        activate DB

        DB --> repo : result
        deactivate DB

        repo --> service : result
        deactivate repo

        service --> controller : success
        deactivate service

        controller --> client : apiResponse
        deactivate controller

        client --> User : Thông báo:\n"Cập nhật email thành công",\nLàm mới giao diện
        deactivate client
    end
end
@enduml